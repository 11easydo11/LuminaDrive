<Application x:Class="UsbRecoverySuite.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UsbRecoverySuite.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToInverseVisibilityConverter x:Key="BoolToInverseVis" />
            <converters:NavSectionToVisibilityConverter x:Key="NavToVis" />
            <converters:HealthToBrushConverter x:Key="HealthToBrush" />
            <converters:HealthTextBrushConverter x:Key="HealthTextBrush" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:LocalizedFormatConverter x:Key="LocalizedFormat" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
