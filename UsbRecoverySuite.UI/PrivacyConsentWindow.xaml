<Window x:Class="UsbRecoverySuite.UI.PrivacyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [PrivacyTitle]}"
        Icon="app_icon.ico"
        Width="600" Height="470" MinWidth="560" MinHeight="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">
    <Grid Margin="24">
        <Border Style="{StaticResource CardStyle}" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" Margin="0,0,14,0">
                        <TextBlock Text="i" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [PrivacyTitle]}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [PrivacySubtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,18" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding [PrivacyIntro]}" FontSize="14" LineHeight="22" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding [PrivacyAccessDetails]}" FontSize="13" LineHeight="21" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <Border Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource WarningColor}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <TextBlock Text="{Binding [PrivacyDataWarning]}" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding [PrivacyLocalNote]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="{Binding [PrivacyDecline]}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" Height="40" Margin="0,0,10,0" IsCancel="True" />
                    <Button Content="{Binding [PrivacyAccept]}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="202" Height="40" IsDefault="True" Click="Accept_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
