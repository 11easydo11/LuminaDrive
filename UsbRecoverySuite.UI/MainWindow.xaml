<Window x:Class="UsbRecoverySuite.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UsbRecoverySuite.UI.ViewModels"
        xmlns:controls="clr-namespace:UsbRecoverySuite.UI.Controls"
        xmlns:models="clr-namespace:UsbRecoverySuite.Core.Models;assembly=UsbRecoverySuite.Core"
        mc:Ignorable="d"
        Title="{Binding Loc[WindowTitle]}"
        Icon="app_icon.ico"
        Height="860" Width="1320"
        MinHeight="640" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable Text, Arial">

    <Grid Background="Transparent">
        <!-- Main Layout: Top Header + Body (Sidebar + Content) + Statusbar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="32" />
        </Grid.RowDefinitions>

        <!-- Soft color wash behind the translucent window surfaces. -->
        <Border Grid.RowSpan="3" IsHitTestVisible="False" Background="{DynamicResource WindowBackground}" />

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- App Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,4">
                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryButtonBackground}" CornerRadius="12" Margin="0,0,12,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Path Data="M 12,9 L 12,26 L 24,26 M 12,18 L 19,18" Stroke="{DynamicResource AccentForeground}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M 25,8 L 25,14 M 22,11 L 28,11" Stroke="{DynamicResource AccentForeground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AppTitle]}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding Loc[AppSubtitle]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Device Selector & Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,4">
                    <TextBlock Text="{Binding Loc[TargetDrive]}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelectDevice}" Width="360" Height="36"
                              Background="{DynamicResource DropdownBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="340" Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,6,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="DeviceDisplayNameFormat">
                                                <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                <Binding Path="DisplayName" />
                                                <Binding Path="DiskIndex" />
                                                <Binding Path="Model" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ReportedCapacityFormatted}" Foreground="{DynamicResource AccentText}" Margin="0,0,6,0" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="NoWrap">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="DeviceTypeFormat">
                                                <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                <Binding Path="DeviceType" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="{Binding Loc[RefreshBtn]}" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" MinHeight="36" />
                </StackPanel>

                <!-- Admin & Export Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <!-- Elevation Badge -->
                    <Border Background="{DynamicResource SuccessSurface}" BorderBrush="{DynamicResource SuccessColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Loc[AdminBadge]}" Foreground="{DynamicResource SuccessText}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Button Content="{Binding Loc[RestartAsAdmin]}" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinHeight="32"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToInverseVis}}" ToolTip="{Binding Loc[RestartAsAdminHint]}" />

                    <!-- Export Report Dropdown/Button -->
                    <Menu Background="Transparent">
                        <MenuItem Header="{Binding Loc[ExportReportBtn]}" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource DropdownBackground}" Height="32" Padding="10,4">
                            <MenuItem Header="{Binding Loc[ExportHtml]}" Command="{Binding ExportReportCommand}" CommandParameter="html" />
                            <MenuItem Header="{Binding Loc[ExportJson]}" Command="{Binding ExportReportCommand}" CommandParameter="json" />
                            <MenuItem Header="{Binding Loc[ExportTxt]}" Command="{Binding ExportReportCommand}" CommandParameter="txt" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- MAIN BODY (Sidebar + Section Views) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="8,12">
                <StackPanel>
                    <TextBlock Text="{Binding Loc[NavSectionMonitor]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavSectionLabel}" Margin="12,4,0,8" />
                    <Button Content="{Binding Loc[NavDashboard]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Dashboard}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavDeviceInfo]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.DeviceInfo}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavPartitions]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.PartitionsVolumes}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavFileOperations]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.FileOperations}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavDiagnostics]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Diagnostics}" Style="{StaticResource NavButtonStyle}" />

                    <Separator Background="{DynamicResource CardBorder}" Margin="8,12" />

                    <TextBlock Text="{Binding Loc[NavSectionRepair]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavSectionLabel}" Margin="12,4,0,8" />
                    <Button Content="{Binding Loc[NavRecovery]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Recovery}" Style="{StaticResource NavButtonStyle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                    <Button Content="{Binding Loc[NavCapacityTest]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.CapacityTest}" Style="{StaticResource NavButtonStyle}" />

                    <Separator Background="{DynamicResource CardBorder}" Margin="8,12" />

                    <TextBlock Text="{Binding Loc[NavSectionSystem]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavSectionLabel}" Margin="12,4,0,8" />
                    <Button Content="{Binding Loc[NavHistory]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.History}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavLogs]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Logs}" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="{Binding Loc[NavSettings]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Settings}" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1" Background="{DynamicResource WindowSurface}">

                <!-- 1. DASHBOARD VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=Dashboard}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[DashboardTitle]}" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="{Binding Loc[DashboardIntro]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,18" TextWrapping="Wrap" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Step1Title]}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding Loc[Step1Hint]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedDeviceSummary}" FontSize="13" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Loc[NoDevicePrompt]}" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToInverseVis}}" FontSize="12" Foreground="{DynamicResource WarningText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Loc[Step2Title]}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding Loc[QuickTasksTitle]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TaskLostSpaceTitle]}" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Loc[TaskLostSpaceDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[TaskLostSpaceBtn]}" Command="{Binding RestoreFullCapacityCommand}" IsEnabled="{Binding CanRestoreFullCapacity}" Style="{StaticResource DangerButtonStyle}" MinHeight="38" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TaskReadOnlyTitle]}" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Loc[TaskReadOnlyDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap" />
                    <Button Content="{Binding Loc[TaskReadOnlyBtn]}" Command="{Binding ClearReadOnlyCommand}" IsEnabled="{Binding CanOperateSelectedDevice}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="38" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TaskCheckErrorsTitle]}" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Loc[TaskCheckErrorsDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap" />
                    <Button Content="{Binding Loc[TaskCheckErrorsBtn]}" Command="{Binding RepairFilesystemCommand}" IsEnabled="{Binding CanOperateSelectedDevice}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="38" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TaskFakeCheckTitle]}" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Loc[TaskFakeCheckDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap" />
                    <Button Content="{Binding Loc[TaskFakeCheckBtn]}" Command="{Binding StartQuickCapacityTestCommand}" IsEnabled="{Binding CanOperateSelectedDevice}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="38" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Step2Hint]}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                <TextBlock Text="{Binding RecommendedAction}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Loc[AdvancedToolsTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="{Binding Loc[NavDiagnostics]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Diagnostics}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{Binding Loc[NavDeviceInfo]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.DeviceInfo}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{Binding Loc[NavPartitions]}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.PartitionsVolumes}" Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. DEVICE INFORMATION VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=DeviceInfo}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[InfoHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="{Binding Loc[InfoSubheading]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                    <RowDefinition Height="Auto" MinHeight="36" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[PropDiskNumber]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="DiskNumberFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.DiskIndex" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[PropModel]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SystemValueFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.Model" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Loc[PropManufacturer]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.Manufacturer}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Loc[PropSerial]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.SerialNumber}" FontFamily="Consolas" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Loc[PropDeviceId]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.DeviceId}" FontFamily="Consolas" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Loc[PropPnpId]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDevice.PnpDeviceId}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Loc[PropVidPid]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="VidPidFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.Vid" />
                                            <Binding Path="SelectedDevice.Pid" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding Loc[PropBusSpeed]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedDevice.UsbVersionSpeed}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding Loc[PropFirmware]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedDevice.FirmwareRevision}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding Loc[PropClassification]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="9" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="DeviceTypeFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.DeviceType" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding Loc[PropRemovable]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="BooleanValue">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.IsRemovable" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="{Binding Loc[PropSectors]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="11" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SectorSizesFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.LogicalSectorSize" />
                                            <Binding Path="SelectedDevice.PhysicalSectorSize" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding Loc[PropPartitionStyle]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedDevice.PartitionStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="13" Grid.Column="0" Text="{Binding Loc[PropReadOnly]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="13" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="ReadOnlyOfflineFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.IsReadOnly" />
                                            <Binding Path="SelectedDevice.IsOffline" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding Loc[PropSmartHealth]}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="14" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource HealthTextBrush}">
                                            <Binding Path="SelectedDevice.Health" />
                                            <Binding Path="IsDarkTheme" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="HealthStatusFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedDevice.Health" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. PARTITIONS & VOLUMES VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=PartitionsVolumes}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[PartitionsHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                        
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[InteractivePartitionMap]}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <controls:PartitionBarControl Device="{Binding SelectedDevice}" Localization="{Binding Loc}" Margin="0,4,0,12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[PartitionList]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding SelectedDevice.Partitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" MinWidth="126" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{DynamicResource PrimaryButtonBackground}" CornerRadius="8" MinWidth="94" MinHeight="38" Padding="10,6" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="PartitionNumberLabel">
                                                                    <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                    <Binding Path="PartitionNumber" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>

                                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,1,12,1">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="MountPointLabel">
                                                                        <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                        <Binding Path="DriveLettersDisplay" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SizeFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" FontSize="13" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="12,2,0,0">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="PartitionTypeFormat">
                                                                        <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                        <Binding Path="PartitionType" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,8,0">
                                                                <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="FilesystemValueFormat">
                                                                    <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                    <Binding Path="Volume.FileSystem" FallbackValue="RAW" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Grid>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12" Foreground="{DynamicResource SuccessText}" HorizontalAlignment="Right">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="FreeSpaceLabel">
                                                                    <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                    <Binding Path="Volume.FreeFormatted" FallbackValue="N/A" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="OffsetValueFormat">
                                                                    <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                                    <Binding Path="OffsetFormatted" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- FILE TRANSFER AND DRIVE ERASE VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=FileOperations}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[FileOperationsHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="{Binding Loc[FileOperationsDescription]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[FileBackupTitle]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Loc[FileBackupDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding Loc[FileBackupPathLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BackupDestinationFolder}" IsReadOnly="True" MinHeight="36" VerticalContentAlignment="Center" ToolTip="{Binding BackupDestinationFolder}" />
                                    <Button Grid.Column="1" Content="{Binding Loc[FileChooseFolder]}" Command="{Binding ChooseBackupFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" MinHeight="36" />
                                </Grid>
                                <Button Content="{Binding Loc[FileCopyFromUsb]}" Command="{Binding CopyUsbToPcCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" MinHeight="38" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[FilePcFilesTitle]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Loc[FilePcFilesDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="FileSelectedFilesFormat">
                                            <Binding Path="Loc" />
                                            <Binding Path="SelectedPcFiles.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Border Background="{DynamicResource LogSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedPcFiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource LogText}" FontSize="11" Margin="0,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{Binding Loc[FileChooseFiles]}" Command="{Binding ChoosePcFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Margin="0,0,8,0" />
                                    <Button Content="{Binding Loc[FileClearSelection]}" Command="{Binding ClearSelectedPcFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Margin="0,0,8,0" />
                                    <Button Content="{Binding Loc[FileCopyToUsb]}" Command="{Binding CopyPcFilesToUsbCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding FileTransferStatus}" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding FileTransferPercent}" Maximum="100" Height="10" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource AccentColor}" Margin="0,8,0,0" />
                                <Button Content="{Binding Loc[FileTransferCancel]}" Command="{Binding CancelFileTransferCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding IsTransferringFiles, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource ErrorColor}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[FileEraseTitle]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ErrorText}" />
                                <TextBlock Text="{Binding Loc[FileEraseDescription]}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                <Button Content="{Binding Loc[FileEraseButton]}" Command="{Binding EraseUsbCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" MinHeight="38" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. DIAGNOSTICS VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=Diagnostics}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Loc[DiagHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="{Binding Loc[DiagSubheading]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding Loc[DiagRerunBtn]}" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="34" />
                        </Grid>

                        <!-- Findings List -->
                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Severity indicator -->
                                            <Border Grid.Column="0" Background="{Binding Severity, Converter={StaticResource HealthToBrush}}" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="0,0,14,0">
                                                <TextBlock FontWeight="Bold" FontSize="11" Foreground="White">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="HealthStatusFormat">
                                                            <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                            <Binding Path="Severity" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,6" TextWrapping="Wrap" />
                                                
                                                <Expander Header="{Binding DataContext.Loc[DiagTechnicalDetails], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" IsExpanded="False" Margin="0,2,0,6">
                                                    <Border Background="{DynamicResource LogSurface}" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding TechnicalDetails}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                                    </Border>
                                                </Expander>

                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Loc[RecommendedActionLabel]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                    <TextBlock Text="{Binding RecommendedAction}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Windows Event Log Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[DiagEventLogTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedDevice.RecentDeviceEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource WarningText}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5. RECOVERY VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=Recovery}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[RecoveryHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="{Binding Loc[RecoverySubheading]}" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <!-- One Click Fix All Card -->
                        <Border Background="{DynamicResource InfoSurface}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Loc[FixAllHeroTitle]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentText}" />
                                    <TextBlock Text="{Binding Loc[FixAllHeroDesc]}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding Loc[FixAllHeroBtn]}" Command="{Binding FixAllCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="44" Padding="24,10" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Granular Wizard & Manual Tools -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Clean & Partition Wizard -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[ManualWizardTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    
                                    <TextBlock Text="{Binding Loc[StyleChoiceLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox SelectedValue="{Binding SelectedPartitionStyle, Mode=TwoWay}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,12" Background="{DynamicResource DropdownBackground}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="{Binding Loc[StyleMbr]}" Tag="{x:Static models:PartitionTableType.MBR}" />
                                        <ComboBoxItem Content="{Binding Loc[StyleGpt]}" Tag="{x:Static models:PartitionTableType.GPT}" />
                                    </ComboBox>

                                    <TextBlock Text="{Binding Loc[FsChoiceLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox SelectedValue="{Binding SelectedFileSystem, Mode=TwoWay}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,12" Background="{DynamicResource DropdownBackground}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="exFAT" Tag="exFAT" ToolTip="{Binding Loc[FsExfatHint]}" />
                                        <ComboBoxItem Content="NTFS" Tag="NTFS" ToolTip="{Binding Loc[FsNtfsHint]}" />
                                        <ComboBoxItem Content="FAT32" Tag="FAT32" ToolTip="{Binding Loc[FsFat32Hint]}" />
                                    </ComboBox>

                                    <TextBlock Text="{Binding Loc[LabelChoiceLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding VolumeLabel, Mode=TwoWay}" Height="32" Margin="0,0,0,16" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6" BorderBrush="{DynamicResource InputBorder}" />

                                    <Button Content="{Binding Loc[CleanAndRebuildBtn]}" Command="{Binding CleanAndRebuildUsbCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="38" />
                                </StackPanel>
                            </Border>

                            <!-- Individual Repair Actions -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[ManualToolsTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                                    <Button Content="{Binding Loc[ToolClearRoBtn]}" Command="{Binding ClearReadOnlyCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" MinHeight="36" HorizontalContentAlignment="Left" />
                                    <Button Content="{Binding Loc[ToolChkdskBtn]}" Command="{Binding CheckFilesystemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" MinHeight="36" HorizontalContentAlignment="Left" />
                                    <Button Content="{Binding Loc[ToolChkdskFixBtn]}" Command="{Binding RepairFilesystemCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" MinHeight="36" HorizontalContentAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Execution Console -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[ExecProgressTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding RecoveryProgressText}" FontSize="12" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8" />

                                    <Border Height="140" Background="{DynamicResource LogSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RecoveryLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentText}" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- BEFORE -> ACTION -> AFTER -> VERIFICATION CARD -->
                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding LastRepairResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[AuditTitle]}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Before Snapshot -->
                                    <Border Grid.Column="0" Background="{DynamicResource GlassSurface}" Padding="12" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[BeforeState]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock FontSize="12" Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotPartitionedFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.BeforeSnapshot.TotalPartitionedFormatted" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource WarningText}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotUnallocatedFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.BeforeSnapshot.UnallocatedFormatted" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotPartitionsFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.BeforeSnapshot.Partitions.Count" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotFilesystemFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.BeforeSnapshot.PrimaryFileSystem" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="➔" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource AccentText}" Margin="12,0" />

                                    <!-- After Snapshot -->
                                    <Border Grid.Column="2" Background="{DynamicResource GlassSurface}" Padding="12" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Loc[AfterState]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" />
                                            <TextBlock FontSize="12" FontWeight="Bold" Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotPartitionedFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.AfterSnapshot.TotalPartitionedFormatted" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotUnallocatedFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.AfterSnapshot.UnallocatedFormatted" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentText}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotMountedLettersFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.AfterSnapshot.DriveLettersDisplay" /></MultiBinding></TextBlock.Text></TextBlock>
                                            <TextBlock FontSize="12"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="SnapshotFilesystemFormat"><Binding Path="Loc" /><Binding Path="LastRepairResult.AfterSnapshot.PrimaryFileSystem" /></MultiBinding></TextBlock.Text></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding LastRepairResult.VerificationSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6. FULL CAPACITY TEST VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=CapacityTest}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[CapTestHeading]}" Style="{StaticResource SectionHeadingStyle}" />
                        
                        <!-- Crucial Notice -->
                        <Border Background="{DynamicResource WarningSurface}" BorderBrush="{DynamicResource WarningColor}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[CapTestNoticeTitle]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningText}" />
                                <TextBlock Text="{Binding Loc[CapTestNoticeText]}" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Loc[CapTestScopeLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                    <ComboBox SelectedValue="{Binding CapacityTestSizeOption, Mode=TwoWay}" SelectedValuePath="Tag" Width="240" Height="34" HorizontalAlignment="Left" Background="{DynamicResource DropdownBackground}" Foreground="{DynamicResource TextPrimary}">
                                        <ComboBoxItem Content="{Binding Loc[CapTestQuick]}" Tag="Quick" />
                                        <ComboBoxItem Content="{Binding Loc[CapTestStandard]}" Tag="Standard" />
                                        <ComboBoxItem Content="{Binding Loc[CapTestExtended]}" Tag="Extended" />
                                        <ComboBoxItem Content="{Binding Loc[CapTestFull]}" Tag="Full" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding Loc[CapTestStartBtn]}" Command="{Binding StartCapacityTestCommand}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Margin="0,0,10,0" />
                                    <Button Content="{Binding Loc[CapTestCancelBtn]}" Command="{Binding CancelCapacityTestCommand}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Progress & Speed -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CapacityTestPhase, FallbackValue='Ready'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Left" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentSpeedMBps, StringFormat='{}{0:F2} MB/s'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Value="{Binding CapacityTestPercent}" Maximum="100" Height="14" Foreground="{DynamicResource AccentText}" Background="{DynamicResource ProgressTrack}" BorderThickness="0" Margin="0,0,0,8" />
                            </StackPanel>
                        </Border>

                        <!-- 4-Metrics Results Breakdown -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CapMetricReported]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding LastCapacityTestResult.ReportedFormatted, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4" />
                                    <TextBlock Text="{Binding Loc[CapMetricReportedDesc]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CapMetricAddressable]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding LastCapacityTestResult.AddressableFormatted, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4" />
                                    <TextBlock Text="{Binding Loc[CapMetricAddressableDesc]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CapMetricVerified]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding LastCapacityTestResult.VerifiedFormatted, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,4" />
                                    <TextBlock Text="{Binding Loc[CapMetricVerifiedDesc]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[CapMetricReliable]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="{Binding LastCapacityTestResult.ReliableFormatted, FallbackValue='--'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessText}" Margin="0,4" />
                                    <TextBlock Text="{Binding Loc[CapMetricReliableDesc]}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Counterfeit / Fake Drive Analysis Card -->
                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding LastCapacityTestResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[CapFakeCardTitle]}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding LastCapacityTestResult.Summary}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding LastCapacityTestResult.FakeDriveEvidence}" FontSize="12" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7. HISTORY VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=History}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Loc[HistoryHeading]}" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Left" Margin="0,0,12,0" />
                            <Button Grid.Column="1" Content="{Binding Loc[HistoryClearBtn]}" Command="{Binding ClearHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="32" />
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding HistoryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding FormattedTime}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessSurface}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource ErrorSurface}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="HistoryStatusFormat">
                                                            <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                            <Binding Path="StatusBadge" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                </Border>
                                                <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocalizedFormat}" ConverterParameter="OperationNameFormat">
                                                            <Binding Path="DataContext.Loc" RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                                                            <Binding Path="OperationName" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 8. REAL-TIME LOGS VIEW -->
                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=Logs}" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Loc[LogsHeading]}" Style="{StaticResource SectionHeadingStyle}" HorizontalAlignment="Left" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="{Binding Loc[LogsClearBtn]}" Command="{Binding ClearLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinHeight="32" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource LogSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedLine}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource LogText}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 9. SETTINGS VIEW -->
                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource NavToVis}, ConverterParameter=Settings}" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[SettingsHeading]}" Style="{StaticResource SectionHeadingStyle}" />

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[SettingsLangTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Loc[SettingsLangDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <ComboBox SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" Width="180" Height="34" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Русский" />
                                    <ComboBoxItem Content="English" />
                                    <ComboBoxItem Content="Українська" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[SettingsThemeTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Loc[SettingsThemeDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <ComboBox SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" Width="180" Height="34" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{Binding DataContext.Loc[ThemeDark], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                    <ComboBoxItem Content="{Binding DataContext.Loc[ThemeLight], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                    <ComboBoxItem Content="{Binding DataContext.Loc[ThemeSystem], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[SettingsSafetyTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Loc[SafetyRule1]}" FontSize="12" Foreground="{DynamicResource SuccessText}" Margin="0,2" />
                                <TextBlock Text="{Binding Loc[SafetyRule2]}" FontSize="12" Foreground="{DynamicResource SuccessText}" Margin="0,2" />
                                <TextBlock Text="{Binding Loc[SafetyRule3]}" FontSize="12" Foreground="{DynamicResource SuccessText}" Margin="0,2" />
                                <TextBlock Text="{Binding Loc[SafetyRule4]}" FontSize="12" Foreground="{DynamicResource SuccessText}" Margin="0,2" />
                                <TextBlock Text="{Binding Loc[SafetyRule5]}" FontSize="12" Foreground="{DynamicResource SuccessText}" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[AboutTitle]}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Loc[AboutDesc]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Loc[AboutVersion]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[HotplugMonitorLabel]}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="{Binding Loc[HotplugActive]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}" />
                    <TextBlock Text="Created by Danyil Sokolov (EASY_DO)" FontSize="10" Foreground="{DynamicResource TextSecondary}" Opacity="0.8" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SAFETY CONFIRMATION MODAL OVERLAY -->
        <Grid Visibility="{Binding IsConfirmDialogOpen, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalOverlay}" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ErrorColor}" BorderThickness="2" CornerRadius="10" Width="520" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmDialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ErrorText}" Margin="0,0,0,12" />
                    
                    <Border Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource ErrorColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <TextBlock Text="{Binding ConfirmDialogWarning}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource InputBackground}" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ConfirmTargetDiskInfo}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding Loc[ConfirmDiskNumberHint]}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ConfirmInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" Padding="6" FontSize="14" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Loc[ConfirmBtnCancel]}" Command="{Binding CancelConfirmDialogCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" MinHeight="36" Padding="18,6" />
                        <Button Content="{Binding Loc[ConfirmBtnOk]}" Command="{Binding ConfirmActionCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="36" Padding="20,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

